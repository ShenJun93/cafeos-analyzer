{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run verify:deploy",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/app/client-config",
      "destination": "/api/app/workflow?route=client-config"
    },
    {
      "source": "/api/app/commerce-menu",
      "destination": "/api/app/workflow?route=commerce-menu"
    },
    {
      "source": "/api/app/commerce-order",
      "destination": "/api/app/workflow?route=commerce-order"
    },
    {
      "source": "/api/app/commerce-payment",
      "destination": "/api/app/workflow?route=commerce-payment"
    },
    {
      "source": "/api/app/commerce-dashboard",
      "destination": "/api/app/workflow?route=commerce-dashboard"
    },
    {
      "source": "/api/app/commerce-daily-close",
      "destination": "/api/app/workflow?route=commerce-daily-close"
    },
    {
      "source": "/api/app/actions",
      "destination": "/api/app/workflow?route=actions"
    },
    {
      "source": "/api/app/action-status",
      "destination": "/api/app/workflow?route=action-status"
    },
    {
      "source": "/api/app/measurement-window",
      "destination": "/api/app/workflow?route=measurement-window"
    },
    {
      "source": "/api/app/action-detail",
      "destination": "/api/app/workflow?route=action-detail"
    },
    {
      "source": "/app",
      "destination": "/app.html"
    },
    {
      "source": "/analyzer",
      "destination": "/analyzer.html"
    },
    {
      "source": "/free-cafe-sales-analyzer",
      "destination": "/index.html"
    },
    {
      "source": "/sample-report",
      "destination": "/sample-report.html"
    },
    {
      "source": "/feedback",
      "destination": "/feedback.html"
    },
    {
      "source": "/phan-tich-file-kiotviet-cafe",
      "destination": "/phan-tich-file-kiotviet-cafe.html"
    },
    {
      "source": "/phan-tich-file-sapo-fnb",
      "destination": "/phan-tich-file-sapo-fnb.html"
    },
    {
      "source": "/phan-tich-doanh-thu-quan-cafe-excel",
      "destination": "/phan-tich-doanh-thu-quan-cafe-excel.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "git": {
    "deploymentEnabled": false
  }
}
